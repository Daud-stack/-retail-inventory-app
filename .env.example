# =============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION FOR NEON DATABASE
# Place this file as '.env' in your project root folder
# =============================================================================

# PostgreSQL Neon Serverless Connection String
# Obtain your connection string from the Neon Console: https://console.neon.tech
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:your_password_here@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional Server & Port Configuration
PORT=5000
NODE_ENV=development
